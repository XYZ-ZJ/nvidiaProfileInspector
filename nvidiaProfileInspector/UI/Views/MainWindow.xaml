<Window
    x:Class="nvidiaProfileInspector.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:nvidiaProfileInspector.UI.Behaviors"
    xmlns:controls="clr-namespace:nvidiaProfileInspector.UI.Controls"
    xmlns:converters="clr-namespace:nvidiaProfileInspector.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="clr-namespace:nvidiaProfileInspector.Common.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:nvidiaProfileInspector.UI.ViewModels"
    Title="NVIDIA PROFILE INSPECTOR"
    Width="1190"
    Height="750"
    MinWidth="1050"
    MinHeight="450"
    d:DataContext="{x:Static vm:DesignTimeData.MainViewModel}"
    Background="Transparent"
    Closing="Window_Closing"
    Cursor="Hand"
    Loaded="Window_Loaded"
    Style="{StaticResource DarkWindowStyle}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate x:Key="SharedValueEditorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Path
                    Width="12"
                    Height="12"
                    Margin="0,0,8,0"
                    Data="{Binding Source, Converter={StaticResource SettingMetaSourceToIconConverter}, Mode=OneWay}"
                    Fill="{DynamicResource TextSecondaryBrush}"
                    Stretch="Uniform" />
                <TextBlock
                    FontFamily="{DynamicResource SettingsFontFamily}"
                    Text="{Binding ValueName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </DataTemplate>

        <controls:SearchableComboBox x:Key="SharedValueEditorResource"
                                     Padding="8,4"
                                     FontFamily="{DynamicResource SettingsFontFamily}"
                                     HorizontalAlignment="Stretch"
                                     Foreground="{Binding State, Converter={StaticResource StateToColorConverter}, Mode=OneWay}"
                                     behaviors:SettingValueValidationBehavior.Enabled="True"
                                     Cursor=""
                                     DeferSelectionUntilCommit="True"
                                     IsEditable="True"
                                     ItemsSource="{Binding ValueNameItems, Mode=OneWay}"
                                     MaxDropDownHeight="400"
                                     Placeholder="搜索数值..."
                                     PreserveSelectionOnKeyboardFocus="True"
                                     SyncSelectedItemToText="False"
                                     Text="{Binding SelectedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Validation.ErrorTemplate="{x:Null}"
                                     ItemTemplate="{StaticResource SharedValueEditorItemTemplate}">
            <controls:SearchableComboBox.Style>
                <Style TargetType="controls:SearchableComboBox" BasedOn="{StaticResource {x:Type controls:SearchableComboBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsModified}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:SearchableComboBox.Style>
        </controls:SearchableComboBox>
    </Window.Resources>


    <Window.InputBindings>
        <KeyBinding
            Key="F"
            Command="{Binding FocusFilterCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="S"
            Command="{Binding ApplyCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="R"
            Command="{Binding RefreshCommand}"
            Modifiers="Ctrl" />
        <KeyBinding Key="Escape" Command="{Binding ClearFilterCommand}" />
        <KeyBinding
            Key="D"
            Command="{Binding ToggleDevModeCommand}"
            Modifiers="Ctrl+Alt" />
    </Window.InputBindings>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Header/Title  -->
            <RowDefinition Height="Auto" />
            <!--  Command Bar  -->
            <RowDefinition Height="Auto" />
            <!--  Status/Applications  -->
            <RowDefinition Height="*" />
            <!--  Settings List  -->
            <RowDefinition Height="Auto" />
            <!--  Description  -->
            <RowDefinition Height="Auto" />
            <!--  Footer/Progress  -->
        </Grid.RowDefinitions>

        <!--  Header / Title Bar  -->
        <controls:TitleBar
            x:Name="AppTitleBar"
            Title=""
            Grid.Row="0"
            Background="{DynamicResource TitleBarBackdropBrush}"
            Cursor=""
            TitleFontSize="16"
            TitleForeground="{DynamicResource TitleBrush}">
            <controls:TitleBar.Resources>
                <SolidColorBrush x:Key="Layer1BackgroundBrush" Color="{DynamicResource TitleBarPopupBackgroundColor}" />
                <SolidColorBrush x:Key="Layer2BackgroundBrush" Color="{DynamicResource TitleBarControlBackgroundColor}" />
                <SolidColorBrush x:Key="Layer3BackgroundBrush" Color="{DynamicResource TitleBarControlHoverBackgroundColor}" />
                <SolidColorBrush x:Key="ControlBorderBrush" Color="{DynamicResource TitleBarControlBorderColor}" />
                <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="{DynamicResource TitleBarControlBorderHoverColor}" />
            </controls:TitleBar.Resources>

            <controls:TitleBar.IconContent>
                <Path
                    Width="20"
                    Height="20"
                    Data="{StaticResource IconInspectorApp}"
                    Fill="{DynamicResource NvidiaGreenBrush}"
                    Stretch="Uniform" />
            </controls:TitleBar.IconContent>

            <controls:TitleBar.LeftContent>
                <StackPanel Margin="12,0,0,0" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TitleBrush}"
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </controls:TitleBar.LeftContent>

            <controls:TitleBar.CenterContent>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <!--  Global Profile Button  -->
                    <Button
                        x:Name="GlobalProfileButton"
                        Margin="0,0,8,0"
                        Command="{Binding NavigateToGlobalCommand}"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="转到全局驱动配置文件">
                        <Path
                            Width="18"
                            Height="18"
                            Data="{DynamicResource IconGlobe}"
                            Fill="{DynamicResource AccentBrush}"
                            Stretch="Uniform" />
                    </Button>

                    <!--  Profile Selector  -->
                    <controls:SearchableComboBox
                        x:Name="ProfileCombo"
                        Width="400"
                        Height="32"
                        Margin="0,0,0,0"
                        IsEditable="False"
                        IsSynchronizedWithCurrentItem="False"
                        ItemsSource="{Binding ProfileNames}"
                        MaxDropDownHeight="500"
                        Placeholder="搜索配置文件..."
                        SelectedValue="{Binding CurrentProfile}"
                        SelectedValuePath="ProfileName"
                        SyncSelectedItemToText="True">
                        <controls:SearchableComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProfileListItem}">
                                <Grid ToolTip="{Binding ProfileTypeLabel}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource TextSecondaryBrush}"
                                        Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{DynamicResource IconNvidia}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGlobal}" Value="True">
                                                        <Setter Property="Data" Value="{DynamicResource IconGlobe}" />
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUserDefined}" Value="True">
                                                        <Setter Property="Data" Value="{DynamicResource IconUser}" />
                                                        <Setter Property="Fill" Value="{DynamicResource NvidiaGreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{Binding ProfileName}" />
                                </Grid>
                            </DataTemplate>
                        </controls:SearchableComboBox.ItemTemplate>
                    </controls:SearchableComboBox>

                    <!--  Modified Profiles Selector  -->
                    <controls:SearchableComboBox
                        x:Name="ModifiedProfilesCombo"
                        Margin="8,0,0,0"
                        ItemsSource="{Binding ModifiedProfiles}"
                        MaxDropDownHeight="500"
                        Placeholder="搜索已修改的配置文件..."
                        PreviewKeyDown="ModifiedProfilesCombo_PreviewKeyDown"
                        SelectionChanged="ModifiedProfilesCombo_SelectionChanged"
                        Style="{DynamicResource IconSearchableComboBoxStyle}"
                        SyncSelectedItemToText="True"
                        ToolTip="查看已修改的配置文件">
                        <controls:SearchableComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModifiedProfileItem}">
                                <Grid ToolTip="{Binding ProfileTypeLabel}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource TextSecondaryBrush}"
                                        Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{DynamicResource IconNvidia}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUserDefined}" Value="True">
                                                        <Setter Property="Data" Value="{DynamicResource IconUser}" />
                                                        <Setter Property="Fill" Value="{DynamicResource NvidiaGreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{Binding ProfileName}" />
                                </Grid>
                            </DataTemplate>
                        </controls:SearchableComboBox.ItemTemplate>
                    </controls:SearchableComboBox>
                </StackPanel>
            </controls:TitleBar.CenterContent>
            <controls:TitleBar.RightContent>
                <StackPanel Orientation="Horizontal">
                    <Grid>
                        <Button
                            x:Name="AppearanceButton"
                            Width="32"
                            Height="32"
                            Margin="4,0"
                            Padding="0"
                            Background="{DynamicResource Layer2BackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            Command="{Binding ToggleAppearanceMenuCommand}"
                            Cursor="Hand"
                            ToolTip="外观">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsAppearanceMenuOpen}" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Path
                                Width="18"
                                Height="18"
                                Data="{DynamicResource IconTheme}"
                                Fill="{DynamicResource TextSecondaryBrush}"
                                Stretch="Uniform" />
                        </Button>
                        <Popup
                            x:Name="AppearancePopup"
                            AllowsTransparency="True"
                            HorizontalOffset="-68"
                            IsOpen="{Binding IsAppearanceMenuOpen, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=AppearanceButton}"
                            StaysOpen="False"
                            VerticalOffset="4">
                            <Border
                                Margin="8,0,8,8"
                                Padding="8"
                                Background="{DynamicResource Layer2BackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Direction="270"
                                        Opacity="0.25"
                                        ShadowDepth="4" />
                                </Border.Effect>
                                <StackPanel Width="168">
                                    <!--  Theme Section  -->
                                    <TextBlock
                                        Margin="6,4,6,4"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="主题" />
                                    <Button
                                        Margin="0,1"
                                        Padding="6,5"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="Midnight"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                                    Visibility="{Binding IsMidnightTheme, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="午夜黑" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="0,1"
                                        Padding="6,5"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="Dark"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                                    Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="暗黑" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="0,1"
                                        Padding="6,5"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="Slate"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                                    Visibility="{Binding IsSlateTheme, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="石板灰" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="0,1"
                                        Padding="6,5"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="CleanWhite"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                                    Visibility="{Binding IsCleanWhiteTheme, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="纯白" />
                                        </StackPanel>
                                    </Button>
                                    <!--  Separator  -->
                                    <Border
                                        Height="1"
                                        Margin="6,6"
                                        Background="{DynamicResource ControlBorderBrush}" />
                                    <!--  Density Section  -->
                                    <TextBlock
                                        Margin="6,4,6,4"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="密度" />
                                    <Button
                                        Margin="0,1"
                                        Padding="6,5"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetDensityCommand}"
                                        CommandParameter="Modern"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                                    Visibility="{Binding IsCompactDensity, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="现代" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="0,1"
                                        Padding="6,5"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetDensityCommand}"
                                        CommandParameter="Compact"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                                    Visibility="{Binding IsCompactDensity, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="紧凑" />
                                        </StackPanel>
                                    </Button>
                                    <Border
                                        Height="1"
                                        Margin="6,6"
                                        Background="{DynamicResource ControlBorderBrush}" />
                                    <TextBlock
                                        Margin="6,4,6,4"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="背景效果" />
                                    <Button
                                        Margin="0,1"
                                        Padding="6,5"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetBackdropModeCommand}"
                                        CommandParameter="Default"
                                        Cursor="Hand"
                                        Visibility="{Binding IsWindows10, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                                    Visibility="{Binding IsBackdropGlass, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="玻璃" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="0,1"
                                        Padding="6,5"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetBackdropModeCommand}"
                                        CommandParameter="MainWindow"
                                        Cursor="Hand"
                                        Visibility="{Binding IsWindows11, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                                    Visibility="{Binding IsBackdropMica, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="Mica" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="0,1"
                                        Padding="6,5"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetBackdropModeCommand}"
                                        CommandParameter="Tabbed"
                                        Cursor="Hand"
                                        Visibility="{Binding IsWindows11, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                                    Visibility="{Binding IsBackdropMicaVariant, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="Mica 变体" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="0,1"
                                        Padding="6,5"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetBackdropModeCommand}"
                                        CommandParameter="Acrylic"
                                        Cursor="Hand"
                                        Visibility="{Binding IsWindows11, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                                    Visibility="{Binding IsBackdropAcrylic, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="亚克力" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="0,1"
                                        Padding="6,5"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SetBackdropModeCommand}"
                                        CommandParameter="Disabled"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="bd"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Layer3BackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                                    Visibility="{Binding IsBackdropDisabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="已禁用" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button
                        Margin="4,0"
                        Command="{Binding ShowAboutCommand}"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="关于">
                        <Grid>
                            <Path
                                Width="18"
                                Height="18"
                                Data="{DynamicResource IconInfo}"
                                Fill="{DynamicResource TextSecondaryBrush}"
                                Stretch="Uniform" />
                            <!--  Update Badge  -->
                            <Grid
                                Margin="0,-4,-4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                <!--  Ripple Effect  -->
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="{DynamicResource NvidiaGreenBrush}"
                                    IsHitTestVisible="False"
                                    Opacity="0.4"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="RippleScale" ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <Trigger Property="Visibility" Value="Visible">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                    To="2.5"
                                                                    Duration="0:0:2.0" />
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                    To="2.5"
                                                                    Duration="0:0:2.0" />
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="0"
                                                                    Duration="0:0:2.0" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!--  Core Dot  -->
                                <Border
                                    Width="10"
                                    Height="10"
                                    Background="{DynamicResource NvidiaGreenBrush}"
                                    BorderBrush="{DynamicResource WindowBackgroundBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="5">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="8"
                                            Opacity="0.8"
                                            ShadowDepth="0"
                                            Color="#76b900" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>
            </controls:TitleBar.RightContent>
        </controls:TitleBar>

        <Border
            Grid.Row="1"
            Grid.RowSpan="5"
            Background="{DynamicResource Layer1BackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Command Bar  -->
                <Border
                    Grid.Row="0"
                    Padding="16,8"
                    Background="{DynamicResource Layer2BackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Cursor=""
                            Orientation="Horizontal">
                            <controls:ActionBarButton
                                Command="{Binding RestoreProfileCommand}"
                                IconFill="{DynamicResource TextSecondaryBrush}"
                                IconPath="{DynamicResource IconNvidia}"
                                Text="默认"
                                ToolTip="将配置文件恢复为 NVIDIA 默认设置" />

                            <controls:ActionBarButton
                                Command="{Binding CreateProfileCommand}"
                                Cursor="Hand"
                                IconFill="{DynamicResource TextSecondaryBrush}"
                                IconPath="{DynamicResource IconAdd}"
                                Text="新建"
                                ToolTip="新建配置文件" />

                            <controls:ActionBarButton
                                Command="{Binding DeleteProfileCommand}"
                                IconFill="{DynamicResource TextSecondaryBrush}"
                                IconPath="{DynamicResource IconDelete}"
                                Text="删除"
                                ToolTip="删除当前配置文件" />

                            <controls:ActionBarButton
                                Command="{Binding CopySettingsCommand}"
                                IconFill="{DynamicResource TextSecondaryBrush}"
                                IconPath="{DynamicResource IconCopy}"
                                Text="复制"
                                ToolTip="复制设置到剪贴板" />

                            <controls:ActionBarButton
                                Command="{Binding OpenBitEditorCommand}"
                                IconFill="{DynamicResource TextSecondaryBrush}"
                                IconPath="{DynamicResource IconBitEditor}"
                                Text="位编辑器"
                                ToolTip="打开位值编辑器" />

                            <Separator Style="{StaticResource ToolBarSeparatorStyle}" />

                            <controls:ActionBarButton
                                x:Name="ExportButton"
                                Click="ExportButton_Click"
                                IconFill="{DynamicResource TextSecondaryBrush}"
                                IconPath="{DynamicResource IconExport}"
                                Text="导出"
                                ToolTip="导出配置文件到文件" />

                            <controls:ActionBarButton
                                x:Name="ImportButton"
                                Click="ImportButton_Click"
                                IconFill="{DynamicResource TextSecondaryBrush}"
                                IconPath="{DynamicResource IconImport}"
                                Text="导入"
                                ToolTip="从文件导入配置文件" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <controls:ActionBarButton
                                Command="{Binding RefreshCommand}"
                                IconFill="{DynamicResource TextSecondaryBrush}"
                                IconPath="{DynamicResource IconRefresh}"
                                Text="刷新"
                                ToolTip="刷新所有配置文件" />

                            <controls:ActionBarButton
                                Command="{Binding RefreshCurrentProfileCommand}"
                                IconPath="{DynamicResource IconRestore}"
                                Text="重置"
                                ToolTip="重置当前配置文件的更改">
                                <controls:ActionBarButton.Style>
                                    <Style BasedOn="{StaticResource {x:Type controls:ActionBarButton}}" TargetType="controls:ActionBarButton">
                                        <Setter Property="IconFill" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="TextForeground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                                <Setter Property="IconFill" Value="{DynamicResource NvidiaGreenBrush}" />
                                                <Setter Property="TextForeground" Value="{DynamicResource TextPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:ActionBarButton.Style>
                            </controls:ActionBarButton>

                            <controls:ActionBarButton
                                Command="{Binding ApplyCommand}"
                                Cursor="Hand"
                                FontWeight="Bold"
                                IconPath="{DynamicResource IconApply}"
                                Text="应用更改"
                                TextFontSize="11"
                                ToolTip="应用所有更改并保存">
                                <controls:ActionBarButton.Style>
                                    <Style BasedOn="{StaticResource {x:Type controls:ActionBarButton}}" TargetType="controls:ActionBarButton">
                                        <Setter Property="IconFill" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="TextForeground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                                <Setter Property="IconFill" Value="{DynamicResource NvidiaGreenBrush}" />
                                                <Setter Property="TextForeground" Value="{DynamicResource TextPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:ActionBarButton.Style>
                            </controls:ActionBarButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Applications Area with Badges  -->
                <Border
                    Grid.Row="1"
                    Padding="16,8"
                    Background="{DynamicResource Layer1BackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding ShowApplicationsArea, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Orientation="Horizontal">
                            <Button
                                Click="AddApplication_Click"
                                Content="添加应用程序"
                                Style="{StaticResource AddApplicationButtonStyle}"
                                ToolTip="向此配置文件添加新应用程序" />
                            <Separator Margin="0,4,0,4" Style="{StaticResource ToolBarSeparatorStyle}" />
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="12,0,0,0">
                            <ItemsControl ItemsSource="{Binding Applications}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:CollapsibleWrapPanel
                                            HasOverflow="{Binding ApplicationsHasOverflow, Mode=OneWayToSource}"
                                            IsExpanded="{Binding ApplicationsExpanded}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Click="RemoveApplication_Click"
                                            Style="{StaticResource ApplicationChipStyle}"
                                            Tag="{Binding}"
                                            ToolTip="{Binding KeyDisplay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <ToggleButton
                            Grid.Row="1"
                            Grid.Column="2"
                            IsChecked="{Binding ApplicationsExpanded}"
                            Style="{StaticResource ApplicationsExpandToggleStyle}"
                            ToolTip="显示全部应用程序 / 折叠为单行"
                            Visibility="{Binding ApplicationsHasOverflow, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <!--  Settings List Area  -->
                <Grid Grid.Row="2" Margin="16,16,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Filter Row  -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Search Box with Icon  -->
                        <controls:SearchableTextBox
                            x:Name="FilterTextBox"
                            Grid.Column="0"
                            Placeholder="搜索设置..."
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="按名称搜索设置 (Ctrl+F)" />

                        <!--  Source Filter Flyout  -->
                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <Button
                                x:Name="FilterSourceButton"
                                Command="{Binding ToggleFilterMenuCommand}"
                                Style="{StaticResource FilterSourceButtonStyle}"
                                ToolTip="筛选设置与数值来源">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{DynamicResource IconFilter}"
                                    Fill="{DynamicResource TextSecondaryBrush}"
                                    Stretch="Uniform" />
                            </Button>
                            <Popup
                                x:Name="FilterPopup"
                                AllowsTransparency="True"
                                HorizontalOffset="-8"
                                IsOpen="{Binding IsFilterMenuOpen, Mode=TwoWay}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=FilterSourceButton}"
                                StaysOpen="False"
                                VerticalOffset="4">
                                <Border
                                    Margin="8,0,8,8"
                                    Padding="8"
                                    Background="{DynamicResource Layer2BackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="16"
                                            Direction="270"
                                            Opacity="0.25"
                                            ShadowDepth="4" />
                                    </Border.Effect>
                                    <StackPanel Width="252">
                                        <TextBlock Style="{StaticResource FilterFlyoutCategoryHeaderStyle}" Text="设置来源" />
                                        <CheckBox IsChecked="{Binding SettingSourceCommon}" Style="{StaticResource FilterFlyoutCheckBoxStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="{DynamicResource IconSettings}"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="通用 (CSN)" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding SettingSourceDriver}" Style="{StaticResource FilterFlyoutCheckBoxStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="{DynamicResource IconNvidia}"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="驱动 API" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding SettingSourceConstants}" Style="{StaticResource FilterFlyoutCheckBoxStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="{DynamicResource IconBitEditor}"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="驱动常量" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding SettingSourceReference}" IsEnabled="{Binding IsReferenceAvailable}" Style="{StaticResource FilterFlyoutCheckBoxStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="{DynamicResource IconInfo}"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="参考数据" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding SettingSourceScan}" IsEnabled="{Binding IsScanAvailable}" Style="{StaticResource FilterFlyoutCheckBoxStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="{DynamicResource IconSearch}"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="预定义扫描" />
                                            </StackPanel>
                                        </CheckBox>

                                        <Border
                                            Height="1"
                                            Margin="6,6,6,2"
                                            Background="{DynamicResource ControlBorderBrush}"
                                            Opacity="0.5" />
                                        <CheckBox
                                            IsChecked="{Binding ShowActiveFromDisabledSources}"
                                            Style="{StaticResource FilterFlyoutCheckBoxStyle}"
                                            ToolTip="即使关闭了某个设置来源，当其设置在当前配置文件中处于活动状态（预定义、全局或用户设置值）时仍会显示。">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="显示已关闭来源中的活动设置"
                                                TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox
                                            IsChecked="{Binding AllowMetaFromInactiveSources}"
                                            Style="{StaticResource FilterFlyoutCheckBoxStyle}"
                                            ToolTip="允许设置的名称和描述来自当前已关闭的来源。">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="名称和描述取自未启用的来源"
                                                TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox
                                            IsChecked="{Binding ShowSettingIdInName}"
                                            Style="{StaticResource FilterFlyoutCheckBoxStyle}"
                                            ToolTip="在列表中将设置 ID 前缀显示在设置名称之前（双击名称可复制其 ID）。">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="在名称中显示设置 ID"
                                                TextWrapping="Wrap" />
                                        </CheckBox>

                                        <Border
                                            Height="1"
                                            Margin="6,8"
                                            Background="{DynamicResource ControlBorderBrush}" />

                                        <TextBlock Style="{StaticResource FilterFlyoutCategoryHeaderStyle}" Text="数值来源" />
                                        <CheckBox IsChecked="{Binding ValueSourceCommon}" Style="{StaticResource FilterFlyoutCheckBoxStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="{DynamicResource IconSettings}"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="通用 (CSN)" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding ValueSourceDriver}" Style="{StaticResource FilterFlyoutCheckBoxStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="{DynamicResource IconNvidia}"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="驱动 API" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding ValueSourceConstants}" Style="{StaticResource FilterFlyoutCheckBoxStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="{DynamicResource IconBitEditor}"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="驱动常量" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding ValueSourceReference}" IsEnabled="{Binding IsReferenceAvailable}" Style="{StaticResource FilterFlyoutCheckBoxStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="{DynamicResource IconInfo}"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="参考数据" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding ValueSourceScan}" IsEnabled="{Binding IsScanAvailable}" Style="{StaticResource FilterFlyoutCheckBoxStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="{DynamicResource IconSearch}"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="预定义扫描" />
                                            </StackPanel>
                                        </CheckBox>

                                        <Border
                                            Height="1"
                                            Margin="6,6,6,2"
                                            Background="{DynamicResource ControlBorderBrush}"
                                            Opacity="0.5" />
                                        <CheckBox
                                            IsChecked="{Binding MergeDistinctValues}"
                                            Style="{StaticResource FilterFlyoutCheckBoxStyle}"
                                            ToolTip="将不同来源中相同数值的条目合并为一项（优先显示高优先级的名称）。">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="合并不同数值"
                                                TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox
                                            IsChecked="{Binding AddPredefinedAppListToCommon}"
                                            IsEnabled="{Binding IsScanAvailable}"
                                            Style="{StaticResource FilterFlyoutCheckBoxStyle}"
                                            ToolTip="让预定义扫描（应用程序列表）的数值合并到对应的通用数值中，而不是单独显示一行。">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="将预定义应用程序列表并入通用数值"
                                                TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox
                                            IsChecked="{Binding AddRawValueToCommon}"
                                            Style="{StaticResource FilterFlyoutCheckBoxStyle}"
                                            ToolTip="将原始数值作为前缀显示在通用 (CSN) 数值名称之前，与其他来源的显示方式保持一致。">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="在通用数值中添加原始值"
                                                TextWrapping="Wrap" />
                                        </CheckBox>

                                        <Border
                                            Height="1"
                                            Margin="6,8,6,4"
                                            Background="{DynamicResource ControlBorderBrush}" />
                                        <Button
                                            Command="{Binding ResetFilterDefaultsCommand}"
                                            Style="{StaticResource FilterFlyoutResetButtonStyle}"
                                            ToolTip="将所有筛选和数值选项恢复为默认">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="13"
                                                    Height="13"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Data="{DynamicResource IconRestore}"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="恢复默认" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!--  Modified Only Toggle  -->
                        <ToggleButton
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            IsChecked="{Binding ModifiedOnly}"
                            Style="{StaticResource ModifiedOnlyToggleStyle}"
                            ToolTip="仅显示活动或已修改的设置" />
                    </Grid>

                    <!--  Settings ListView  -->
                    <Grid Grid.Row="1">
                        <ListBox
                            x:Name="SettingsListView"
                            FontFamily="{DynamicResource SettingsFontFamily}"
                            behaviors:GridViewColumnResizeBehavior.EnableStarSizing="True"
                            behaviors:GridViewColumnResizeBehavior.HexColumnWidth="200"
                            behaviors:GridViewColumnResizeBehavior.SettingColumnMinWidth="320"
                            behaviors:GridViewColumnResizeBehavior.SettingColumnStarWidth="1"
                            behaviors:GridViewColumnResizeBehavior.ValueColumnMinWidth="320"
                            behaviors:GridViewColumnResizeBehavior.ValueColumnStarWidth="1"
                            behaviors:ScrollIntoViewForListView.Enable="{Binding ScrollIntoViewEnabled}"
                            ItemsSource="{Binding GroupedSettingsView}"
                            SelectedItem="{Binding SelectedSetting}"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingPanel.CacheLength="1,1"
                            VirtualizingPanel.CacheLengthUnit="Page"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            Style="{StaticResource SettingsListBoxStyle}">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource SettingsListBoxItemStyle}" TargetType="ListBoxItem">
                                <Setter Property="BorderThickness" Value="2,0,0,0" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Margin" Value="{DynamicResource FlatSettingRowMargin}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ModifiedSettingBackgroundBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource NvidiaGreenBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="Margin" Value="{DynamicResource FlatGroupHeaderMargin}" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.Resources>
                            <!--  Group header row of the flattened settings list  -->
                            <DataTemplate DataType="{x:Type vm:SettingGroupHeaderViewModel}">
                                <ToggleButton
                                    Cursor="Hand"
                                    Focusable="False"
                                    IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                    OverridesDefaultStyle="True">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                Margin="8,0"
                                                Padding="{DynamicResource GroupHeaderPadding}"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1">
                                                <DockPanel>
                                                    <Path
                                                        x:Name="Arrow"
                                                        Margin="8,0,4,0"
                                                        VerticalAlignment="Center"
                                                        Data="M0,0 L4,4 L8,0 Z"
                                                        DockPanel.Dock="Right"
                                                        Fill="{DynamicResource TextSecondaryBrush}"
                                                        RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource NvidiaGreenBrush}"
                                                        Text="{Binding Name}" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource NvidiaGreenBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </DataTemplate>
                            <!--  Setting row  -->
                            <DataTemplate DataType="{x:Type vm:SettingItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=(behaviors:GridViewColumnResizeBehavior.CalculatedSettingColumnWidth)}" />
                                        <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=(behaviors:GridViewColumnResizeBehavior.CalculatedValueColumnWidth)}" />
                                        <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=(behaviors:GridViewColumnResizeBehavior.HexColumnWidth)}" />
                                    </Grid.ColumnDefinitions>
                                            <Path
                                                x:Name="SettingStateIcon"
                                                Grid.Column="0"
                                                Width="14"
                                                Height="14"
                                                HorizontalAlignment="Center"
                                                Data="{Binding State, Converter={StaticResource StateToIconConverter}, Mode=OneWay}"
                                                Fill="{Binding State, Converter={StaticResource StateToSettingIconColorConverter}, Mode=OneWay}"
                                                Stretch="Uniform"
                                                ToolTip="{Binding State, Converter={StaticResource StateToTooltipConverter}, Mode=OneWay}" />

                                            <Button
                                                Grid.Column="1"
                                                Width="20"
                                                Height="20"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="切换收藏">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Data="{StaticResource IconStar}"
                                                    Fill="{Binding IsFavorite, Converter={StaticResource FavoriteToBrushConverter}, Mode=OneWay}"
                                                    Stretch="Uniform" />
                                            </Button>

                                            <TextBlock
                                                x:Name="SettingNameText"
                                                Grid.Column="2"
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding State, Converter={StaticResource StateToSettingIconColorConverter}, Mode=OneWay}"
                                                Text="{Binding DisplayName, Mode=OneWay}"
                                                ToolTip="{Binding SettingIdHex, Mode=OneWay}"
                                                ToolTipService.IsEnabled="{Binding DataContext.IsDevMode, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding
                                                        Command="{Binding DataContext.CopySettingIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Gesture="LeftDoubleClick" />
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                    <Grid Grid.Column="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            x:Name="ValueEditorAnchor"
                                            Grid.Column="0"
                                            Margin="-2,-1,4,-1"
                                            Background="Transparent" />
                                        <ContentControl
                                            x:Name="ValueEditorHost"
                                            Grid.Column="0"
                                            Margin="-2,-1,4,-1"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            x:Name="DisplayText"
                                            Grid.Column="0"
                                            Margin="12,0"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding State, Converter={StaticResource StateToColorConverter}, Mode=OneWay}"
                                            Text="{Binding SelectedValue, Mode=OneWay}"
                                            TextWrapping="NoWrap" />
                                        <Button
                                            x:Name="RestoreButton"
                                            Grid.Column="1"
                                            Width="28"
                                            Height="28"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.ResetValueCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="将设置重置为默认值"
                                            Visibility="Collapsed">
                                            <Path
                                                x:Name="RestoreButtonIcon"
                                                Width="14"
                                                Height="14"
                                                Data="{StaticResource IconRestore}"
                                                Fill="{StaticResource NvidiaGreenBrush}"
                                                Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                            <TextBlock
                                                x:Name="HexValueText"
                                                Grid.Column="4"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Consolas"
                                                Foreground="{Binding State, Converter={StaticResource StateToColorConverter}, Mode=OneWay}"
                                                Text="{Binding ValueRaw, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding ValueRaw, Mode=OneWay}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                        <Setter TargetName="SettingStateIcon" Property="Data" Value="{StaticResource IconUser}" />
                                        <Setter TargetName="SettingStateIcon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter TargetName="SettingStateIcon" Property="ToolTip" Value="用户修改的设置" />
                                        <Setter TargetName="SettingNameText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter TargetName="DisplayText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter TargetName="HexValueText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="RestoreButton" Property="ToolTip" Value="重置未保存的更改" />
                                        <Setter TargetName="RestoreButtonIcon" Property="Data" Value="{StaticResource IconRestore}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="DisplayText" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="ValueEditorHost" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsUserDefined}" Value="True" />
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                            <Condition Binding="{Binding IsModified}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="RestoreButton" Property="ToolTip" Value="将设置重置为 NVIDIA 默认值" />
                                        <Setter TargetName="RestoreButtonIcon" Property="Data" Value="{StaticResource IconNvidia}" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.Resources>
                        </ListBox>
                    </Grid>
                </Grid>


                <!--  Setting Description  -->
                <Border
                    Grid.Row="3"
                    Margin="16,0,16,16"
                    Padding="12"
                    Background="{DynamicResource Layer3BackgroundBrush}"
                    CornerRadius="8"
                    Visibility="{Binding SettingDescription, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{DynamicResource NvidiaGreenBrush}"
                            Text="描述" />
                        <TextBox
                            MaxHeight="80"
                            Padding="0"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            IsReadOnly="True"
                            Style="{StaticResource DarkTextBoxStyle}"
                            Text="{Binding SettingDescription, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!--  Footer / Progress  -->
                <Border
                    Grid.Row="4"
                    Padding="10,6"
                    Background="{DynamicResource Layer1BackgroundBrush}">
                    <Grid>
                        <Grid Visibility="{Binding IsProgressFooterVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource NvidiaGreenBrush}"
                                Text="正在扫描配置文件" />
                            <ProgressBar
                                Grid.Column="1"
                                Height="12"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Maximum="100"
                                Style="{StaticResource DarkProgressBarStyle}"
                                Value="{Binding ScanProgress}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{Binding ScanProgressText}" />
                        </Grid>
                        <Grid Visibility="{Binding IsStatusFooterVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Margin="0,0,10,0"
                                    Click="CustomSettingsOverrideChip_Click"
                                    Content="{Binding StatusModeText}"
                                    Style="{StaticResource WarningStatusChipButtonStyle}"
                                    Visibility="{Binding StatusModeText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button.ToolTip>
                                        <ToolTip Content="自定义设置正从外部 CustomSettingNames.xml 文件加载" />
                                    </Button.ToolTip>
                                </Button>
                                <Button
                                    Content="{Binding StatusDriverText}"
                                    Cursor="Arrow"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    IsHitTestVisible="False"
                                    IsTabStop="False"
                                    Style="{StaticResource StatusChipButtonStyle}"
                                    Visibility="{Binding StatusDriverText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                <Button
                                    Content="{Binding StatusProfilesText}"
                                    Cursor="Arrow"
                                    IsHitTestVisible="False"
                                    IsTabStop="False"
                                    Style="{StaticResource StatusChipButtonStyle}"
                                    Visibility="{Binding StatusProfilesText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                <Button
                                    Content="{Binding StatusSettingsText}"
                                    Cursor="Arrow"
                                    IsHitTestVisible="False"
                                    IsTabStop="False"
                                    Style="{StaticResource StatusChipButtonStyle}"
                                    Visibility="{Binding StatusSettingsText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                <Button
                                    Content="{Binding StatusOtaText}"
                                    Cursor="Arrow"
                                    IsHitTestVisible="False"
                                    IsTabStop="False"
                                    Style="{StaticResource StatusChipButtonStyle}"
                                    Visibility="{Binding StatusOtaText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Margin="0,0,10,0"
                                    Content="{Binding StatusVersionText}"
                                    Cursor="Arrow"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    IsHitTestVisible="False"
                                    IsTabStop="False"
                                    Style="{StaticResource StatusChipButtonStyle}"
                                    Visibility="{Binding StatusVersionText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                <Button
                                    Margin="0"
                                    Command="{Binding ShowAboutCommand}"
                                    Content="{Binding StatusUpdateHintText}"
                                    Style="{StaticResource AccentStatusChipButtonStyle}"
                                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  Snackbar Notifications  -->
        <controls:NotificationSnackbar
            Grid.RowSpan="6"
            IsActive="{Binding IsSnackbarActive}"
            Message="{Binding SnackbarMessage}"
            Type="{Binding SnackbarType}" />

    </Grid>


</Window>
