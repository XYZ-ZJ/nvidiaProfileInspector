<Window
    x:Class="nvidiaProfileInspector.UI.Views.Dialogs.BitEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:nvidiaProfileInspector.UI.Controls"
    xmlns:converters="clr-namespace:nvidiaProfileInspector.UI.Converters;assembly=nvidiaProfileInspector"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:nvidiaProfileInspector.UI.ViewModels"
    Title="位值编辑器"
    Width="1241"
    Height="864"
    MinHeight="864"
    MaxHeight="1320"
    d:DataContext="{x:Static vm:DesignTimeData.BitEditorViewModel}"
    SizeToContent="Manual"
    Style="{StaticResource DarkDialogWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style
            x:Key="BitEditorListViewItemStyle"
            BasedOn="{StaticResource DarkListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Padding" Value="{DynamicResource ListItemPadding}" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource Layer2BackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BitEditorGridHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Layer2BackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title Bar (Draggable Area)  -->
        <Border
            Grid.Row="0"
            Padding="24,12,0,0"
            Background="Transparent">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="位值编辑器" />

                <StackPanel
                    Grid.Column="1"
                    Margin="0,-12,0,0"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button
                        Click="Close_Click"
                        Style="{StaticResource CloseWindowButtonStyle}"
                        ToolTip="关闭">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{StaticResource IconClose}"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Content  -->
        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,16"
                FontSize="13"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="查看单个标志位，与扫描到的配置文件进行比对，并在启动游戏时快速测试该值。"
                TextWrapping="Wrap" />

            <controls:SearchableTextBox
                x:Name="FilterTextBox"
                Grid.Row="1"
                Margin="0,0,0,12"
                Placeholder="筛选配置文件名称..."
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="筛选已扫描的配置文件名称" />

            <Grid Grid.Row="2" MinHeight="360">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    Padding="10,6"
                    Background="{DynamicResource NvidiaGreenBrush}"
                    BorderBrush="{DynamicResource NvidiaGreenPressedBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasMatchesAboveVisibleRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="12"
                            Height="12"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="M 12 4 L 20 12 L 16 12 L 16 20 L 8 20 L 8 12 L 4 12 Z"
                            Fill="{DynamicResource TextOnAccentBrush}"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            Text="{Binding MatchesAboveVisibleRange, StringFormat={}{0} matches above the visible area}" />
                    </StackPanel>
                </Border>

                <ListView
                    x:Name="BitsListView"
                    Grid.Row="1"
                    MinHeight="360"
                    AlternationCount="2"
                    ItemContainerStyle="{StaticResource BitEditorListViewItemStyle}"
                    ItemsSource="{Binding FilteredBits}"
                    Loaded="BitsListView_Loaded"
                    SelectionMode="Single"
                    SizeChanged="BitsListView_SizeChanged"
                    Style="{StaticResource DarkListViewStyle}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource BitEditorGridHeaderStyle}">
                            <GridViewColumn Header="#">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BitLabel}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="启用">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource DarkCheckBoxStyle}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="描述">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MaskDescription}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="出现次数">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProfileCount}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="配置文件">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VisibleProfileNames}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border
                    Grid.Row="2"
                    Margin="0,6,0,0"
                    Padding="10,6"
                    Background="{DynamicResource NvidiaGreenBrush}"
                    BorderBrush="{DynamicResource NvidiaGreenPressedBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasMatchesBelowVisibleRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="12"
                            Height="12"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="M 8 4 L 16 4 L 16 12 L 20 12 L 12 20 L 4 12 L 8 12 Z"
                            Fill="{DynamicResource TextOnAccentBrush}"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            Text="{Binding MatchesBelowVisibleRange, StringFormat={}{0} matches below the visible area}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="410" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="16"
                    Background="{DynamicResource Layer2BackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="测试区" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="将编辑后的值应用到当前配置文件，然后可选择启动游戏可执行文件立即测试。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBox
                            x:Name="GamePathTextBox"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,12,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource DarkTextBoxStyle}"
                            Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="游戏可执行文件路径" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            MinWidth="96"
                            Margin="0,12,8,0"
                            Padding="12,6"
                            Click="Browse_Click"
                            Style="{StaticResource DarkButtonStyle}"
                            ToolTip="浏览游戏可执行文件">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Data="{DynamicResource IconFolder}"
                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Stretch="Uniform" />
                                <TextBlock VerticalAlignment="Center" Text="浏览" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            MinWidth="140"
                            Margin="0,12,0,0"
                            Padding="12,6"
                            Command="{Binding ApplyAndLaunchCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTip="应用更改并启动游戏">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Data="{DynamicResource IconGame}"
                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Stretch="Uniform" />
                                <TextBlock VerticalAlignment="Center" Text="应用并启动" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{DynamicResource Layer2BackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.ColumnSpan="2"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="当前值" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="查看并应用当前位掩码值。" />
                        <Grid
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="值：" />
                            <TextBox
                                x:Name="CurrentValueTextBox"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                IsReadOnly="True"
                                Style="{StaticResource DarkTextBoxStyle}"
                                Text="{Binding CurrentValueHex, Mode=OneWay}"
                                ToolTip="当前 DWORD 值" />
                            <Button
                                Grid.Column="2"
                                MinWidth="96"
                                Padding="12,6"
                                Command="{Binding ApplyCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTip="应用位更改">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Data="{DynamicResource IconApply}"
                                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Stretch="Uniform" />
                                    <TextBlock VerticalAlignment="Center" Text="应用" />
                                </StackPanel>
                            </Button>
                            <Button
                                IsCancel="True"
                                Grid.Column="3"
                                MinWidth="80"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Click="Close_Click"
                                Content="关闭"
                                Style="{StaticResource DarkButtonStyle}"
                                ToolTip="不保存关闭" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock
                x:Name="StatusTextBlock"
                Grid.Row="4"
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding StatusMessage}" />
        </Grid>
    </Grid>
</Window>
